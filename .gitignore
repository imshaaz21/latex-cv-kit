# --- Your personal data ---
# BEGIN private
# config.tex holds your name, contact details and CV content, so it is ignored by
# default. './track.sh private' removes this block to track it, which is only safe
# in a private repository.
config.tex
# END private
# Any notes or emails you keep per application name the company and a contact.
email*.md
notes*.md
# applications/<Company_Role>/ holds each application's built outputs.
applications/

# --- Build outputs ---
*.pdf
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.bak*
